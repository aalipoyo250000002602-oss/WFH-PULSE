# Server only: enable after applying migration 0027 and configuring providers.
PUSH_NOTIFICATIONS_ENABLED=false
FCM_SERVICE_ACCOUNT_JSON={"project_id":"YOUR_FIREBASE_PROJECT","client_email":"YOUR_SERVICE_ACCOUNT_EMAIL","private_key":"YOUR_PEM_PRIVATE_KEY"}
APNS_KEY_ID=YOUR_APNS_KEY_ID
APNS_TEAM_ID=YOUR_APPLE_TEAM_ID
APNS_PRIVATE_KEY="YOUR_PEM_PRIVATE_KEY"
APNS_TOPIC=com.wfh.pulse

# Mobile build only: enable after adding native provider configuration.
VITE_PUSH_NOTIFICATIONS_ENABLED=false
VITE_APNS_ENVIRONMENT=production
