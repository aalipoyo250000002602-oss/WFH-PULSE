{
  "name": "@figma/my-make-file",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "dev:host": "vite --host 0.0.0.0 --port 5173",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "start": "vite",
    "setup": "corepack pnpm install",
    "android:sync": "powershell -ExecutionPolicy Bypass -File ./scripts/android-sync.ps1",
    "android:run": "powershell -ExecutionPolicy Bypass -File ./scripts/android-run.ps1",
    "android:run:auto": "powershell -ExecutionPolicy Bypass -File ./scripts/android-run.ps1",
    "android:run:emu": "powershell -ExecutionPolicy Bypass -File ./scripts/android-run.ps1 emulator-5554",
    "android:open": "powershell -ExecutionPolicy Bypass -File ./scripts/android-open.ps1",
    "android:build:Pixel7": "corepack pnpm run android:run --target Pixel_7",
    "android:build:Pixel10Pro": "corepack pnpm run android:run --target Pixel_10_Pro",
    "android:full": "powershell -ExecutionPolicy Bypass -Command \"corepack pnpm run build; corepack pnpm run android:sync; corepack pnpm run android:run:auto\"",
    "git:status:short": "git --no-pager status --short",
    "db:check-config": "node ./database/test-connection.mjs --check-config",
    "db:test": "node ./database/test-connection.mjs",
    "db:setup": "node ./database/apply-sql.mjs",
    "db:setup:dry": "node ./database/apply-sql.mjs --dry-run",
    "db:schema": "node ./database/apply-sql.mjs --schema-only",
    "db:seed": "node ./database/apply-sql.mjs --seed-only",
    "db:migrate": "node ./database/migrate.mjs up",
    "db:migrate:down": "node ./database/migrate.mjs down",
    "db:migrate:status": "node ./database/migrate.mjs status",
    "db:migrate:dry": "node ./database/migrate.mjs status --dry-run",
    "db:sync:all": "node ./scripts/build-sync-dbs.mjs",
    "db:sync:all:dry": "node ./scripts/build-sync-dbs.mjs --dry-run",
    "db:sync:all:no-build": "node ./scripts/build-sync-dbs.mjs --skip-build",
    "api:dev": "node ./api/server.mjs",
    "api:check": "node ./api/server.mjs --check",
    "api:smoke": "node ./api/smoke-test.mjs",
    "api:newman": "newman run ./api/postman/WFH-PULSE-API.postman_collection.json -e ./api/postman/WFH-PULSE-Local.postman_environment.json",
    "api:newman:ci": "newman run ./api/postman/WFH-PULSE-API.postman_collection.json -e ./api/postman/WFH-PULSE-Local.postman_environment.json --reporters cli,junit --reporter-junit-export ./api/postman/newman-report.xml"
  },
