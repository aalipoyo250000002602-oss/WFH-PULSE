{
  "name": "wfh-pulse",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "corepack enable && pnpm install",
    "dev": "vite",
    "dev:host": "vite --host 0.0.0.0",
    "dev:local": "vite --mode local",
    "dev:prod": "vite --mode prod",
    "dev:prod:5174": "vite --mode prod --port 5174",
    "local:all": "concurrently \"node api/server.mjs\" \"vite --host 0.0.0.0\"",
    "prod:all": "concurrently \"node api/server.mjs --prod\" \"vite --mode prod --host 0.0.0.0\"",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "android:sync": "vite build && npx cap sync android",
    "android:run:auto": "vite build && npx cap sync android && npx cap run android",
    "android:sync:local": "vite --mode local && npx cap sync android",
    "android:run:local": "vite --mode local && npx cap sync android && npx cap run android",
    "android:run:emu": "vite build && npx cap sync android && npx cap run android -t emulator-5554",
    "android:run:local:emu": "vite --mode local && npx cap sync android && npx cap run android -t emulator-5554",
    "android:open": "npx cap open android",
    "ios:sync": "vite build && npx cap sync ios",
    "ios:sync:local": "vite --mode local && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "ios:build:prod": "node scripts/ios-production.mjs build",
    "ios:run:prod": "node scripts/ios-production.mjs run",
    "ios:launch:prod": "node scripts/ios-production.mjs launch",
    "api:dev": "node api/server.mjs",
    "api:dev:local": "node api/server.mjs --local",
    "api:smoke": "node api/smoke-test.mjs",
    "api:smoke:adjustments": "node api/smoke-adjustment-actions.mjs",
    "api:smoke:adjustments:strict": "node api/smoke-adjustment-actions.mjs --strict",
    "api:newman": "newman run api/postman/WFH-PULSE-API.postman_collection.json -e api/postman/WFH-PULSE-Local.postman_environment.json",
    "api:newman:ci": "newman run api/postman/WFH-PULSE-API.postman_collection.json -e api/postman/WFH-PULSE-Local.postman_environment.json --reporters cli,junit --reporter-junit-export api/postman/newman-report.xml",
    "db:migrate": "node database/migrate.mjs up",
    "db:migrate:dry": "node database/migrate.mjs up --dry-run",
    "db:migrate:status": "node database/migrate.mjs status",
    "db:migrate:down": "node database/migrate.mjs down",
    "db:setup": "node database/apply-sql.mjs",
    "db:setup:dry": "node database/apply-sql.mjs --dry-run",
    "db:sync:all": "node scripts/build-sync-dbs.mjs",
    "db:sync:all:dry": "node scripts/build-sync-dbs.mjs --dry-run",
    "db:sync:all:no-build": "node scripts/build-sync-dbs.mjs --skip-build",
    "db:sync:data": "node scripts/build-sync-dbs.mjs --data-only",
    "db:sync:data:dry": "node scripts/build-sync-dbs.mjs --data-only --dry-run"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "7.3.5",
    "@mui/material": "7.3.5",
    "@popperjs/core": "2.11.8",
    "@radix-ui/react-accordion": "1.2.3",
    "@radix-ui/react-alert-dialog": "1.1.6",
    "@radix-ui/react-aspect-ratio": "1.1.2",
    "@radix-ui/react-avatar": "1.1.3",
    "@radix-ui/react-checkbox": "1.1.4",
    "@radix-ui/react-collapsible": "1.1.3",
    "@radix-ui/react-context-menu": "2.2.6",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-dropdown-menu": "2.1.6",
    "@radix-ui/react-hover-card": "1.1.6",
    "@radix-ui/react-label": "2.1.2",
    "@radix-ui/react-menubar": "1.1.6",
    "@radix-ui/react-navigation-menu": "1.2.5",
    "@radix-ui/react-popover": "1.1.6",
    "@radix-ui/react-progress": "1.1.2",
    "@radix-ui/react-radio-group": "1.2.3",
    "@radix-ui/react-scroll-area": "1.2.3",
    "@radix-ui/react-select": "2.1.6",
    "@radix-ui/react-separator": "1.1.2",
    "@radix-ui/react-slider": "1.2.3",
    "@radix-ui/react-slot": "1.1.2",
    "@radix-ui/react-switch": "1.1.3",
    "@radix-ui/react-tabs": "1.1.3",
    "@radix-ui/react-toggle": "1.1.2",
    "@radix-ui/react-toggle-group": "1.1.2",
    "@radix-ui/react-tooltip": "1.1.8",
    "@supabase/server": "^1.9.1",
    "canvas-confetti": "1.9.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "cors": "^2.8.6",
    "date-fns": "3.6.0",
    "embla-carousel-react": "8.6.0",
    "express": "^4.22.2",
    "input-otp": "1.4.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "0.487.0",
    "motion": "12.23.24",
    "next-themes": "0.4.6",
    "pg": "^8.22.0",
    "react": "18.3.1",
    "react-day-picker": "8.10.1",
    "react-dnd": "16.0.1",
    "react-dnd-html5-backend": "16.0.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.55.0",
    "react-popper": "2.3.0",
    "react-resizable-panels": "2.1.7",
    "react-responsive-masonry": "2.7.1",
    "react-router": "7.13.0",
    "react-slick": "0.31.0",
    "recharts": "2.15.2",
    "sonner": "2.0.3",
    "tailwind-merge": "3.2.0",
    "tw-animate-css": "1.3.8",
    "vaul": "1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@tailwindcss/vite": "4.1.12",
    "@vitejs/plugin-react": "4.7.0",
    "newman": "^6.2.1",
    "prettier": "^3.9.6",
    "tailwindcss": "4.1.12",
    "vite": "6.3.5"
  }
}
